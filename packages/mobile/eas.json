{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "node": "24.13.0",
      "env": {
        "EXPO_PUBLIC_RASP_PROD": "0",
        "EXPO_PUBLIC_DISABLE_RASP": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "node": "24.13.0",
      "env": {
        "EXPO_PUBLIC_DISABLE_RASP": "0",
        "EXPO_PUBLIC_RASP_PROD": "1",
        "EXPO_PUBLIC_ANDROID_PACKAGE": "vip.astrotalk.panel",
        "EXPO_PUBLIC_ANDROID_CERT_HASHES": "Tu3djWkQPOFLVbzfw3yUYJF0ag/0Ypyn7ML4887z+/0=",
        "EXPO_PUBLIC_RASP_MAIL": "security@astrotalk.vip"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
