# Copy to mobile/.env and fill in — same values as the desktop app's .env
EXPO_PUBLIC_API_BASE_URL=https://your-api-host
EXPO_PUBLIC_ENTK_VALUE=your-entk-value

# SSL pinning — GET /api/generate. The stress key is optional public
# compatibility configuration; bootstrap pins remain the trust anchor.
# EXPO_PUBLIC_SSL_PIN_GENERATE_URL=https://laxminarayan.live/api/generate
# EXPO_PUBLIC_SSL_STRESS_KEY=public-compatibility-value

# freeRASP (Android) — Base64 SHA-256 of the EAS release keystore cert
# EXPO_PUBLIC_RASP_PROD=1
# EXPO_PUBLIC_ANDROID_PACKAGE=vip.astrotalk.panel
# EXPO_PUBLIC_ANDROID_CERT_HASHES=Tu3djWkQPOFLVbzfw3yUYJF0ag/0Ypyn7ML4887z+/0=
# EXPO_PUBLIC_RASP_MAIL=security@astrotalk.vip

# Optional: Basic Auth for protected call-recording URLs (same as desktop .env)
# Comma-separated HTTPS recording origins. Defaults to the API origin.
# EXPO_PUBLIC_RECORDING_ALLOWED_HOSTS=https://recordings.example.com
# EXPO_PUBLIC_RECORDING_BASIC_AUTH_USERNAME=recording_service_username
# EXPO_PUBLIC_RECORDING_BASIC_AUTH_PASSWORD=recording_service_password
