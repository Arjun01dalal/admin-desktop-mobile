# Copy to mobile/.env and fill in — same values as the desktop app's .env
EXPO_PUBLIC_API_BASE_URL=https://your-api-host
EXPO_PUBLIC_ENTK_VALUE=your-entk-value

# freeRASP (Android) — Base64 SHA-256 of the EAS release keystore cert
# EXPO_PUBLIC_RASP_PROD=1
# EXPO_PUBLIC_ANDROID_PACKAGE=vip.astrotalk.panel
# EXPO_PUBLIC_ANDROID_CERT_HASHES=Tu3djWkQPOFLVbzfw3yUYJF0ag/0Ypyn7ML4887z+/0=
# EXPO_PUBLIC_RASP_MAIL=security@astrotalk.vip
