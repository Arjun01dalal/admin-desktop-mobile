{
  "name": "@astro/mobile",
  "version": "1.1.0",
  "main": "index.ts",
  "dependencies": {
    "@astro/shared": "file:../shared",
    "@expo/metro-runtime": "~57.0.14",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/drawer": "^7.13.5",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@types/crypto-js": "^4.2.2",
    "crypto-js": "^4.2.0",
    "expo": "~57.0.20",
    "expo-asset": "~57.0.15",
    "expo-audio": "~57.0.4",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.16",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-image-picker": "~57.0.14",
    "expo-location": "~57.0.14",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.15",
    "expo-screen-capture": "~57.0.2",
    "expo-screen-orientation": "~57.0.2",
    "expo-secure-store": "~57.0.2",
    "expo-sharing": "~57.0.16",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.19",
    "freerasp-react-native": "^4.4.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-ssl-public-key-pinning": "^1.2.6",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "mkdir -p .metro-tmp && TMPDIR=\"$PWD/.metro-tmp\" expo start",
    "start:go": "mkdir -p .metro-tmp && TMPDIR=\"$PWD/.metro-tmp\" expo start --go --lan",
    "android": "mkdir -p .metro-tmp && TMPDIR=\"$PWD/.metro-tmp\" expo run:android",
    "ios": "mkdir -p .metro-tmp && export LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 TMPDIR=\"$PWD/.metro-tmp\" && expo run:ios",
    "web": "mkdir -p .metro-tmp && TMPDIR=\"$PWD/.metro-tmp\" expo start --web",
    "check:ota-signing": "node scripts/check-ota-signing.cjs",
    "build:preview": "env TMPDIR=/tmp eas build --profile preview --platform all",
    "build:preview:android": "env TMPDIR=/tmp eas build --profile preview --platform android",
    "build:preview:ios": "env TMPDIR=/tmp eas build --profile preview --platform ios",
    "build:production": "env TMPDIR=/tmp eas build --profile production --platform all",
    "build:production:android": "env TMPDIR=/tmp eas build --profile production --platform android",
    "build:production:ios": "env TMPDIR=/tmp eas build --profile production --platform ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.{ts,tsx}\" \"scripts/**/*.cjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.{ts,tsx}\" \"scripts/**/*.cjs\""
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  },
  "private": true
}
