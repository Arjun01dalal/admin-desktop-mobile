# Copy to .env and fill in. Never commit .env.
# These values are loaded ONLY in the Electron main process — never exposed to the renderer.
# All network URLs must be HTTPS (cleartext http:// is rejected).

API_BASE_URL=https://laxminarayan.live/api
ENTK_VALUE=your_encryption_secret_here
MOBILE_CDN_BASE=https://d2opi4jisa0j0o.cloudfront.net

# Optional: Basic Auth used by protected call-recording URLs.
# Kept in Electron main process and never exposed to the renderer.
# RECORDING_BASIC_AUTH_USERNAME=recording_service_username
# RECORDING_BASIC_AUTH_PASSWORD=recording_service_password

# Optional: HTTPS webhook for crash / error events (main + renderer).
# ERROR_WEBHOOK_URL=https://hooks.example.com/astro-errors

# Optional: force main-process HTTP request logs (off by default).
# SECURE_API_LOG=1

# Optional: read-only GitHub token so packaged apps can auto-update from a PRIVATE repo.
# Create a fine-grained PAT with Contents: Read on Logicaces/admin-desktop-mobile only.
# GH_UPDATE_TOKEN=ghp_xxxxxxxx

# --- SOS Push (ntfy) ---
# Shared secret topic — use a long random string so outsiders cannot spam it.
# Same topic must be set on every desktop + on the sos-push relay.
# SOS_PUSH_TOPIC=astro-sos-CHANGE_ME_TO_A_LONG_SECRET
# SOS_PUSH_SERVER=https://ntfy.sh
# Adaptive get-sos-flag poll (defaults: idle 30s / idle+push 60s / active 10s):
# SOS_POLL_IDLE_MS=30000
# SOS_POLL_IDLE_PUSH_MS=60000
# SOS_POLL_ACTIVE_MS=10000
# SOS_POLL_NO_TOKEN_MS=60000
#
# --- Firebase / FCM (desktop Astro site login) ---
# Defaults come from mobile google-services.json (astro-admin-panel).
# Override if you register a Web app in Firebase Console:
# FIREBASE_API_KEY=
# FIREBASE_APP_ID=
# FIREBASE_PROJECT_ID=astro-admin-panel
# FIREBASE_MESSAGING_SENDER_ID=344071214084
# FIREBASE_VAPID_KEY=
