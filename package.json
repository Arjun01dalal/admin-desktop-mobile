{
  "name": "astro-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Astro platform monorepo — desktop CS panel, mobile scaffold, shared packages.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run desktop:dev",
    "desktop:dev": "npm run dev -w @astro/desktop",
    "desktop:build": "npm run build -w @astro/desktop",
    "desktop:start": "npm run start -w @astro/desktop",
    "desktop:dist": "npm run dist -w @astro/desktop",
    "desktop:dist:win": "npm run dist:win -w @astro/desktop",
    "desktop:dist:mac": "npm run dist:mac -w @astro/desktop",
    "desktop:dist:all": "npm run dist:all -w @astro/desktop",
    "desktop:release": "npm run release -w @astro/desktop",
    "desktop:release:win": "npm run release:win -w @astro/desktop",
    "desktop:release:mac": "npm run release:mac -w @astro/desktop",
    "desktop:release:all": "npm run release:all -w @astro/desktop",
    "sos-push": "npm run sos-push -w @astro/desktop",
    "mobile:start": "npm run start -w @astro/mobile",
    "shared:typecheck": "npm run typecheck -w @astro/shared"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
